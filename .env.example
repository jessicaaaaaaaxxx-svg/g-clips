# Supabase (required)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# CORS: set to your deployed frontend origin(s), comma-separated.
# Use "*" only for local testing; the Express server also serves the frontend
# itself from the same origin, so "*" is rarely needed in production.
ALLOWED_ORIGIN=*

# Server port (Railway sets this automatically; only needed for local dev)
PORT=3000
